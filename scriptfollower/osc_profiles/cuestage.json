{
  "id": "cuestage",
  "name": "CueStage",
  "port": 53000,
  "notes": "In CueStage: Impostazioni › OSC › «Ricevi comandi OSC», porta UDP (predefinita 53000). Il numero di cue è quello della colonna «N.» (es. 12 o 3.5). Un indirizzo OSC personalizzato di una cue (scheda «Base») si manda con «Indirizzo personalizzato».",
  "commands": [
    {"id": "go", "label": "GO (cue al playhead)", "address": "/go", "args": []},
    {"id": "cue_start", "label": "Avvia una cue", "address": "/cue/{cue}/start", "args": [],
     "params": [{"id": "cue", "label": "Cue", "type": "text", "default": "1"}]},
    {"id": "cue_stop", "label": "Ferma una cue (con fade)", "address": "/cue/{cue}/stop", "args": ["{fade}"],
     "params": [{"id": "cue", "label": "Cue", "type": "text", "default": "1"},
                {"id": "fade", "label": "Fade (s)", "type": "float", "min": 0, "max": 60, "default": 0}]},
    {"id": "cue_pause", "label": "Pausa di una cue", "address": "/cue/{cue}/pause", "args": [],
     "params": [{"id": "cue", "label": "Cue", "type": "text", "default": "1"}]},
    {"id": "cue_resume", "label": "Riprendi una cue", "address": "/cue/{cue}/resume", "args": [],
     "params": [{"id": "cue", "label": "Cue", "type": "text", "default": "1"}]},
    {"id": "cue_level", "label": "Volume di una cue (dB, con fade)", "address": "/cue/{cue}/level", "args": ["{db}", "{fade}"],
     "params": [{"id": "cue", "label": "Cue", "type": "text", "default": "1"},
                {"id": "db", "label": "Livello dB", "type": "float", "min": -60, "max": 12, "default": 0},
                {"id": "fade", "label": "Fade (s)", "type": "float", "min": 0, "max": 60, "default": 2}]},
    {"id": "playhead", "label": "Playhead su una cue", "address": "/playhead/{cue}", "args": [],
     "params": [{"id": "cue", "label": "Cue", "type": "text", "default": "1"}]},
    {"id": "next", "label": "Playhead alla successiva", "address": "/next", "args": []},
    {"id": "previous", "label": "Playhead alla precedente", "address": "/previous", "args": []},
    {"id": "list_go", "label": "GO su una lista (MAIN o PANEL)", "address": "/list/{list}/go", "args": [],
     "params": [{"id": "list", "label": "Lista", "type": "text", "default": "MAIN"}]},
    {"id": "stop", "label": "STOP TUTTO (con fade)", "address": "/stop", "args": []},
    {"id": "panic", "label": "PANIC (stop immediato)", "address": "/panic", "args": []},
    {"id": "pause", "label": "Pausa generale", "address": "/pause", "args": []},
    {"id": "resume", "label": "Ripresa generale", "address": "/resume", "args": []},
    {"id": "xfade", "label": "Crossfade alla successiva", "address": "/xfade", "args": ["{time}"],
     "params": [{"id": "time", "label": "Durata (s)", "type": "float", "min": 0, "max": 120, "default": 3}]},
    {"id": "text_next", "label": "Testo in sequenza: frase successiva", "address": "/text/next", "args": []},
    {"id": "dim", "label": "DIM acceso / spento", "address": "/dim", "args": ["{state}"],
     "params": [{"id": "state", "label": "DIM", "type": "enum", "default": "1", "items": [["1", "Acceso"], ["0", "Spento"]]}]},
    {"id": "custom", "label": "Indirizzo personalizzato di una cue", "address": "{address}", "args": [],
     "params": [{"id": "address", "label": "Indirizzo", "type": "text", "default": "/mia/cue"}]}
  ]
}
