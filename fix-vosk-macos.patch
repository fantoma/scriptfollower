From 01251e12197939e15334f236dc440a620ebefa2b Mon Sep 17 00:00:00 2001
From: fantoma <dfantoma@gmail.com>
Date: Tue, 20 Oct 2026 10:57:27 +0200
Subject: [PATCH] Vosk 0.3.44: la 0.3.45 non ha il pacchetto per macOS
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

La build su macOS si fermava a «No matching distribution found for vosk>=0.3.45».
Nello spec di PyInstaller libvosk.dyld (macOS) va indicata a mano tra i binari.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AiVCnbVdJsKeZTJLEfQrb9
---
 packaging/scriptfollower.spec | 12 +++++++++---
 requirements.txt              |  2 +-
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/packaging/scriptfollower.spec b/packaging/scriptfollower.spec
index b215b37..3862794 100644
--- a/packaging/scriptfollower.spec
+++ b/packaging/scriptfollower.spec
@@ -28,9 +28,15 @@ for path in glob.glob(os.path.join(PKG, "**", "*"), recursive=True):
         continue
     datas.append((path, os.path.dirname(os.path.relpath(path, ROOT))))
 
-# ---- Vosk: libvosk (.so/.dll/.dyld) e le sue dipendenze stanno nella cartella del pacchetto
-datas += collect_data_files("vosk")
-binaries = collect_dynamic_libs("vosk")
+# ---- Vosk: libvosk (.so/.dll/.dyld) e le sue dipendenze stanno nella cartella del pacchetto.
+# Su macOS la libreria si chiama «libvosk.dyld» (estensione insolita): PyInstaller non la riconosce da solo
+# come libreria, quindi la si indica a mano tra i binari (così viene anche firmata insieme all'app).
+import vosk as _vosk  # noqa: E402
+_VDIR = os.path.dirname(_vosk.__file__)
+_LIBS = (".dyld", ".dylib", ".so", ".dll")
+binaries = [(p, "vosk") for p in glob.glob(os.path.join(_VDIR, "*")) if p.endswith(_LIBS)]
+datas += [(src, dst) for src, dst in collect_data_files("vosk") if not src.endswith(_LIBS)]
+binaries += [b for b in collect_dynamic_libs("vosk") if b[0] not in {x[0] for x in binaries}]
 
 # ---- modello vocale incluso (facoltativo)
 model = os.environ.get("SCRIPTFOLLOWER_MODEL_DIR")
diff --git a/requirements.txt b/requirements.txt
index 5a145d0..e867fb7 100644
--- a/requirements.txt
+++ b/requirements.txt
@@ -2,5 +2,5 @@ PySide6>=6.6,<6.12   # come CueStage: 6.12.0 crasha su Python < 3.12
 numpy>=1.24
 sounddevice>=0.4.6
 python-osc>=1.8
-vosk>=0.3.45         # riconoscimento vocale offline (Kaldi)
+vosk>=0.3.44         # riconoscimento vocale offline (Kaldi) — la 0.3.45 non ha il pacchetto per macOS
 pymupdf>=1.24,<2     # lettura e disegno del PDF (la 2.0 si porta dietro onnxruntime: +70 MB)
-- 
2.43.0

